# Identidade do servidor
myhostname = mail.cafeekernel
mydomain = cafeekernel
myorigin = $mydomain

# Interfaces e protocolos
inet_interfaces = all
inet_protocols = ipv4

# Destinos locais aceitos
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain

# Formato moderno de caixa postal
home_mailbox = Maildir/

# TLS genérico para criptografia (Snakeoil padrão)
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file  = /etc/ssl/private/ssl-cert-snakeoil.key
smtpd_use_tls       = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache

# Segurança de transporte
smtp_tls_security_level  = may
smtpd_tls_security_level = may

# Controle de destinatários
smtpd_recipient_restrictions =
    permit_mynetworks,
    reject_unauth_destination

# Rede interna permitida (sua subnet Docker)
mynetworks = 127.0.0.0/8 172.25.0.0/24

# Alias e roteamento local
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# Entrega local via Dovecot (LMTP opcional)
virtual_transport = lmtp:unix:private/dovecot-lmtp

# Nome usado no campo “From” dos e-mails
/etc/mailname → cafeekernel

smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes

# Segurança recomendada
smtpd_tls_auth_only = yes
smtpd_recipient_restrictions =
    permit_sasl_authenticated,
    permit_mynetworks,
    reject_unauth_destination
